    "crash-rate",
    "anr",
    "slow-rendering",
    "startup-time",
    "agent-skills",
    "skills",
    "claude-code"
  ],
  "author": "Naufaldi Athallah Rifqi <naufalrifqi1602@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "googleapis": "^144.0.0"
  }
}
