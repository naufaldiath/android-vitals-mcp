  "description": "Android Vitals for AI agents: run npx android-vitals-mcp-setup to connect your Play Console, then npx android-vitals-install-skills to get crash/ANR/rendering/startup playbooks in every AI CLI.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "android-vitals-mcp": "index.js",
    "android-vitals-install-skills": "bin/install-skills.js",
    "android-vitals-mcp-setup": "bin/setup-mcp.js"
  },
  "files": [
    "index.js",
    "postinstall.js",
    "bin/",
    "lib/",
    "skills/",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "start": "node index.js",
    "install-skills": "node bin/install-skills.js",
    "postinstall": "node postinstall.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "android-vitals",
    "google-play",
